@model List<LabOrder>

@{
    ViewData["Title"] = "注文一覧";
}

<h2>IDOR実験：自分の注文一覧</h2>

<p>現在ログイン中のユーザーID：@ViewBag.LoginUserId</p>

<table border="1" cellpadding="8">
    <tr>
        <th>注文ID</th>
        <th>商品名</th>
        <th>金額</th>
        <th>詳細</th>
    </tr>
    
    @foreach (var order in Model){
        <tr>
            <td>@order.Id</td>
            <td>@order.ItemName</td>
            <td>@order.Price</td>
            <td><a href="/Idor/OrderDetail/@order.Id">詳細を見る</a></td>
        </tr>
    }
</table>